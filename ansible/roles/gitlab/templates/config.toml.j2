concurrent = 4
check_interval = 0

[[runners]]
  name = "homelab-podman-runner"
  url = "https://gitlab.homelab/"
  token = "{{ gitlab_runner_token }}"
  tls-ca-file = "/etc/gitlab-runner/certs/gitlab.homelab.crt"
  tls-verify = false
  request_concurrency = 2
  executor = "docker"
  
  [runners.cache]
    MaxUploadArchiveSize = 0
    shared = false
  
  [runners.docker]
    tls_verify = false
    image = "alpine:latest"
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = ["/cache"]
    pull_policy = ["always", "if-not-present"]
    network_mode = "bridge"
