tls:

http:
  routers:
{% for service in app_services %}
    {{ service.name}}-router:
      rule: "Host(`{{ service.subdomain | default(service.name) }}.alftberg.net `)"
      service: {{ service.name}}-service
      tls:
        certResolver: letsencrypt
{% endfor %}

  services:
{% for service in app_services %}
    {{ service.name}}-service:
      loadBalancer:
        servers:
          - url: "{{ service.protocol }}://{{ service.name}}:{{ service.internal_port }}"
{% endfor %}
